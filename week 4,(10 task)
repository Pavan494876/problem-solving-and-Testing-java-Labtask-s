import java.io.*;
import java.util.Optional;

public class Solution {
    
    // The core function called by the main method
    public static String timeConversion(String s) {
        String ampm = s.substring(s.length() - 2);
        String remainingTime = s.substring(2, s.length() - 2);
        int hour = Integer.parseInt(s.substring(0, 2));

        String militaryHour = Optional.of(ampm)
            .map(marker -> marker.equals("AM") 
                ? (hour == 12 ? 0 : hour) 
                : (hour == 12 ? 12 : hour + 12))
            .map(h -> String.format("%02d", h))
            .orElse("00");

        return militaryHour + remainingTime;
    }

    // REQUIRED MAIN METHOD: This is the entry point that resolves your compiler error
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));
        BufferedWriter bufferedWriter = new BufferedWriter(new OutputStreamWriter(System.out));

        // Reads the single line input time string
        String s = bufferedReader.readLine();

        // Computes the conversion result
