import java.io.*;
import java.util.Arrays;

public class Solution {
    public static void moveZeroes(int[] nums) {
        // Track the position to place the next non-zero element
        int insertPos = 0;
        
        // Single-pass optimal swap loop
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                if (i != insertPos) {
                    int temp = nums[i];
                    nums[i] = nums[insertPos];
                    nums[insertPos] = temp;
                }
                insertPos++;
            }
        }
    }

    // Main method to safely process I/O and display outcomes
    public static void main(String[] args) throws IOException {
        BufferedReader reader = new BufferedReader(new InputStreamReader(System.in));
        
        System.out.println("Enter space-separated numbers (e.g., 0 1 0 3 12):");
        String input = reader.readLine();
        
        if (input == null || input.trim().isEmpty()) {
            return;
        }

        // Java 8 Stream to quickly convert input string into primitive int array
        int[] nums = Arrays.stream(input.trim().split("\\s+"))
                           .mapToInt(Integer::parseInt)
                           .toArray();

        // Process array in-place
        moveZeroes(nums);

        // Java 8 Stream to cleanly format and output results
        String result = Arrays.stream(nums)
                              .mapToObj(String::valueOf)
                              .reduce((a, b) -> a + " " + b)
                              .orElse("");

        System.out.println("Result: " + result);
        reader.close();
    }
}
