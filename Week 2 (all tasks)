class Solution {
    public int removeElement(int[] nums, int val) {
        // k tracks the index where the next non-val element should go
        int k = 0; 
        
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != val) {
                nums[k] = nums[i];
                k++;
            }
        }
        
        return k;
    }
}
