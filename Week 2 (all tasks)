class Solution {
    public int[] shuffle(int[] nums, int n) {
        // Step 1: Pack pairs together into the first half of the array
        for (int i = 0; i < n; i++) {
            // Shift the 'y' value up by 10 bits and combine it with the 'x' value
            nums[i] = (nums[i + n] << 10) | nums[i];
        }
        
        // Step 2: Unpack elements from right to left (backwards)
        // This ensures we don't overwrite elements we still need to read
        int index = 2 * n - 1;
        for (int i = n - 1; i >= 0; i--) {
            int y = nums[i] >> 10;   // Extract 'y' from the upper 10 bits
            int x = nums[i] & 1023;  // Extract 'x' from the lower 10 bits (1023 is 0x3FF)
            
            nums[index--] = y;
            nums[index--] = x;
        }
        
        return nums;
    }
}
