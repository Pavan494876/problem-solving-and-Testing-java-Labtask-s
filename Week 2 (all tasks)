class Solution {
    public int removeDuplicates(int[] nums) {
        if (nums.length == 0) {
            return 0;
        }
        
        // k tracks the index of the last unique element found
        int k = 0; 
        
        for (int i = 1; i < nums.length; i++) {
            // Found a new unique element
            if (nums[i] != nums[k]) {
                k++;
                nums[k] = nums[i];
            }
        }
        
        // The number of unique elements is the index k + 1
        return k + 1;
    }
}
