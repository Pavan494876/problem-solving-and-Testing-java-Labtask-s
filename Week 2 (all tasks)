import java.util.*;

public class test {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        Deque<Integer> deque = new ArrayDeque<>();
        HashSet<Integer> set = new HashSet<>();
        
        int n = in.nextInt();
        int m = in.nextInt();
        int maxUnique = 0;

        for (int i = 0; i < n; i++) {
            int num = in.nextInt();
            
            // Add current element to both deque and unique set
            deque.add(num);
            set.add(num);
            
            // When the window reaches size M
            if (deque.size() == m) {
                // Update the maximum unique count found so far
                if (set.size() > maxUnique) {
                    maxUnique = set.size();
                }
                
                // If we already found a perfectly unique window, we can break early
                if (maxUnique == m) {
                    break;
                }
                
                // Slide the window: remove the oldest element from the front
                int removed = deque.removeFirst();
                
                // If the removed element is no longer present in the current window,
                // remove it from the unique set as well.
                if (!deque.contains(removed)) {
                    set.remove(removed);
                }
            }
        }
        
        System.out.println(maxUnique);
        in.close();
    }
}
